+// EXPERIMENT (local overlay, not for merge): the streamed tile's `mul_add` arithmetic inside the old packed tile.
+#[cfg(feature = "exp-newtile")]
+#[inline(always)]
+unsafe fn step(sums: &mut [[f64; MR]; NR], a: &[f64; MR], b: &[f64; NR]) {
+	for (col, &bj) in sums.iter_mut().zip(b) {
+		for (sum, &l) in col.iter_mut().zip(a) {
+			*sum = l.mul_add(bj, *sum);
+		}
+	}
+}
+
 // A and B each contain depth full packed rows. RESUME loads the raw sums
